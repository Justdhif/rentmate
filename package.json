{
  "name": "rentmate",
  "version": "1.0.0",
  "private": true,
  "description": "RentMate workspace runner",
  "scripts": {
    "dev": "concurrently -n \"backend,web\" -c \"blue,green\" \"npm run start:dev --prefix apps/backend\" \"npm run dev --prefix apps/web\"",
    "dev:backend": "npm run start:dev --prefix apps/backend",
    "dev:web": "npm run dev --prefix apps/web",
    "seed": "npm run db:seed --prefix apps/backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
